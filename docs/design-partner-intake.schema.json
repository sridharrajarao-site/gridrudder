{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridrudder.com/schemas/design-partner-intake-v1.json",
  "title": "GridRudder design-partner intake",
  "description": "Offline qualification metadata only. Never include credentials or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "host", "meter", "workload_contract", "change_control", "data_handling"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "host_owner_confirmed", "test_environment", "operator_role", "stop_authority_role"],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "host_owner_confirmed": { "type": "boolean" },
        "test_environment": { "enum": ["non-production", "approved-maintenance-window"] },
        "operator_role": { "type": "string", "minLength": 1 },
        "stop_authority_role": { "type": "string", "minLength": 1 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_model", "bmc_type", "os", "nvidia_driver", "gpus"],
      "properties": {
        "server_model": { "type": "string" },
        "bmc_type": { "type": "string" },
        "bmc_firmware": { "type": "string" },
        "os": { "type": "string" },
        "kernel": { "type": "string" },
        "nvidia_driver": { "type": "string" },
        "gpus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "count", "power_limit_supported"],
            "properties": {
              "model": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 },
              "gpu_uuid_reference": { "type": "string", "description": "Sensitive identifier; use an access-controlled reference where possible." },
              "power_limit_supported": { "type": "boolean" },
              "minimum_watts": { "type": "number", "exclusiveMinimum": 0 },
              "default_watts": { "type": "number", "exclusiveMinimum": 0 },
              "maximum_watts": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "timestamped", "machine_readable", "sample_interval_seconds"],
      "properties": {
        "source": { "enum": ["redfish", "ipmi-dcmi", "metered-pdu"] },
        "timestamped": { "const": true },
        "machine_readable": { "const": true },
        "sample_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "accuracy_notes": { "type": "string" },
        "clock_source": { "type": "string" }
      }
    },
    "workload_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_description", "interruptible", "guardrails", "baseline_method"],
      "properties": {
        "workload_description": { "type": "string", "minLength": 1 },
        "interruptible": { "const": true },
        "guardrails": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "baseline_method": { "type": "string", "minLength": 1 }
      }
    },
    "change_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_minimum_watts", "approved_original_watts", "emergency_stop", "restoration", "escalation"],
      "properties": {
        "approved_minimum_watts": { "type": "number", "exclusiveMinimum": 0 },
        "approved_original_watts": { "type": "number", "exclusiveMinimum": 0 },
        "conflicting_controller_notes": { "type": "string" },
        "emergency_stop": { "type": "string", "minLength": 1 },
        "restoration": { "type": "string", "minLength": 1 },
        "escalation": { "type": "string", "minLength": 1 }
      }
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_fields", "storage_location", "access_roles", "retention_days", "publication_consent"],
      "properties": {
        "approved_fields": { "type": "array", "items": { "type": "string" } },
        "storage_location": { "type": "string" },
        "access_roles": { "type": "array", "items": { "type": "string" } },
        "retention_days": { "type": "integer", "minimum": 0 },
        "publication_consent": { "enum": ["none", "sanitized-compatibility-only", "separate-written-consent-required"] }
      }
    }
  }
}
